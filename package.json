{
  "name": "cordio-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:api": "pnpm --filter @cordio/api start:dev",
    "dev:web": "pnpm --filter @cordio/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @cordio/api migration:run",
    "db:seed": "pnpm --filter @cordio/api seed"
  }
}
